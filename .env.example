# Docker Compose PostgreSQL settings for local development only.
# Never use these sample values in production; inject unique credentials from a secret manager.
POSTGRES_DB=repomind
POSTGRES_USER=repomind
POSTGRES_PASSWORD=repomind

# API connection for Docker Compose. Keep this URL in sync with the POSTGRES_* values above.
# If the API runs directly on your machine, use localhost instead of the Compose hostname `db`.
DATABASE_URL=postgresql+psycopg://repomind:repomind@db:5432/repomind

# Optional, server-side credentials for real embeddings and generated answers.
# If absent, the UI explicitly labels demo retrieval mode and does not fabricate AI responses.
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional read-only GitHub token to increase public API rate limits. No write scopes.
GITHUB_TOKEN=
MAX_REPO_FILES=250
MAX_FILE_BYTES=512000
MAX_TOTAL_BYTES=20000000
GITHUB_TIMEOUT_SECONDS=12
CORS_ORIGINS=http://localhost:3000
